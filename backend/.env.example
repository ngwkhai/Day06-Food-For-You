PORT=8000
PUBLIC_API_URL=http://localhost:8000
DATA_FILE_PATH=../data/mock_foods.json
FOOD_REPOSITORY=json

OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
LLM_TIMEOUT_MS=10000

# AI rerank: chọn top 3 món từ candidates đã lọc (fallback rule nếu lỗi)
FOOD_RERANK_ENABLED=true
FOOD_RERANK_CANDIDATE_POOL_SIZE=12

# Ưu tiên ngữ cảnh chat: giữ đủ nội dung N lượt gần nhất, lượt cũ rút gọn
CHAT_RECENT_TURN_COUNT=8
CHAT_OLDER_TURN_MAX_CHARS=160
